# Loop backend environment — authoritative reference for every var
# `src/env.ts` declares. Copy to `.env` for local dev; values here are
# examples/defaults, never real secrets.

# ── Runtime ─────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────
# Document store driver. `memory` (default) loads the whole database
# into memory from DB_JSON_PATH and flushes writes back (debounced,
# atomic rename); `mongo` connects to MONGODB_URI.
DB_DRIVER=memory
# Where the memory driver persists ('' → ephemeral, no persistence —
# the unit-test posture).
DB_JSON_PATH=_data/db.json
# Required when DB_DRIVER=mongo (boot fails without it).
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=loop

# ── Upstream CTX (the gift-card supplier + payment processor) ───────
GIFT_CARD_API_BASE_URL=https://spend.ctx.com
# Operator API credentials — required at boot (ADR 052: they
# authenticate every upstream surface).
GIFT_CARD_API_KEY=
GIFT_CARD_API_SECRET=
# Client IDs for upstream auth — defaults come from @loop/shared
# DEFAULT_CLIENT_IDS; override per deployment only with a matching
# web rebuild (audit A-018).
# CTX_CLIENT_ID_WEB=loopweb
# CTX_CLIENT_ID_IOS=loopios
# CTX_CLIENT_ID_ANDROID=loopandroid
# ADR 052: chain-qualified CTX payment currencies offered at checkout,
# comma-separated. Unset → XLM only.
# LOOP_CTX_PAYMENT_CURRENCIES=XLM

# ── Catalog ─────────────────────────────────────────────────────────
# LOCATION_REFRESH_INTERVAL_HOURS=24
# Comma-separated CTX merchant IDs to exclude from the catalog (A2-1922).
# LOOP_MERCHANT_DENYLIST=
# Path to a MaxMind GeoLite2-Country .mmdb (ADR 033) for /api/public/geo.
# MAXMIND_GEOLITE2_PATH=

# ── Loop-native auth (ADR 013 / 014 / 030) ──────────────────────────
# LOOP_AUTH_NATIVE_ENABLED=true
# HS256 signing secret, min 32 chars; _PREVIOUS during rotation windows.
# LOOP_JWT_SIGNING_KEY=
# LOOP_JWT_SIGNING_KEY_PREVIOUS=
# RS256 (PKCS8 PEM) — when set, new JWTs sign RS256 and the public
# keys publish at /.well-known/jwks.json.
# LOOP_JWT_RSA_PRIVATE_KEY=
# LOOP_JWT_RSA_PRIVATE_KEY_PREVIOUS=
# R3-7 rollback override ("1" only): permit production without native auth.
# DISABLE_NATIVE_AUTH_ENFORCEMENT=1
# Async CTX customer provisioning at signup/login (attributed operator
# traffic). Default true.
# CTX_USER_PROVISIONING_ENABLED=true
# Social login (ADR 014).
# GOOGLE_OAUTH_CLIENT_ID_WEB=
# GOOGLE_OAUTH_CLIENT_ID_IOS=
# GOOGLE_OAUTH_CLIENT_ID_ANDROID=
# APPLE_SIGN_IN_SERVICE_ID=

# ── Transactional email (required with native auth in production) ───
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@loopfinance.io
# EMAIL_FROM_NAME=Loop
# EMAIL_REPLY_TO_ADDRESS=hello@loopfinance.io

# ── Orders / redemption ─────────────────────────────────────────────
# Gift-card redeem-secret envelope key (CF-25 / NS-10). 32 bytes as
# base64/hex; required in production. `openssl rand -base64 32`.
# LOOP_REDEEM_ENCRYPTION_KEY=
# NS-10 rollback override ("1" only): permit production with plaintext
# redeem secrets.
# DISABLE_REDEEM_ENCRYPTION_ENFORCEMENT=1

# ── Launch gate ─────────────────────────────────────────────────────
# Phase 1 only: web hides every Phase 2+ cashback/wallet surface.
# LOOP_PHASE_1_ONLY=true

# ── Retention sweeps ────────────────────────────────────────────────
# LOOP_AUTH_ROW_PURGE_INTERVAL_HOURS=1
# LOOP_AUTH_ROW_RETENTION_DAYS=30

# ── Cashback split defaults (ADR 052) ───────────────────────────────
# Fallback split for merchants without a cashback config row; the sum
# must be ≤ 100 (boot-checked).
# DEFAULT_USER_CASHBACK_PCT_OF_CTX=0.00
# DEFAULT_LOOP_MARGIN_PCT_OF_CTX=0.00

# ── Rate limiting / trust boundary ──────────────────────────────────
# Set true ONLY behind a trusted edge proxy (audit A-023).
# TRUST_PROXY=true
# Test-harness escape hatch — never in production (A2-1605).
# DISABLE_RATE_LIMITING=1
# Fallback per-machine divisor when Fly `.internal` DNS is unavailable (S4-4).
# RATE_LIMIT_MACHINE_COUNT_ESTIMATE=1
# Injected by Fly automatically — never set by hand.
# FLY_APP_NAME=

# ── Test-only ───────────────────────────────────────────────────────
# AUDIT-2-E: second gate (with NODE_ENV=test) for the /__test__/*
# surface. Min 16 chars; production refuses to boot if set.
# LOOP_TEST_ENDPOINTS_SECRET=

# ── Mobile deep-link verification (M-3) ─────────────────────────────
# APPLE_TEAM_ID=
# ANDROID_CERT_SHA256=
# MIN_SUPPORTED_APP_VERSION_IOS=
# MIN_SUPPORTED_APP_VERSION_ANDROID=

# ── Observability ───────────────────────────────────────────────────
# METRICS_BEARER_TOKEN=
# SENTRY_DSN=
# SENTRY_RELEASE=
# LOOP_ENV=staging
# DISCORD_WEBHOOK_ORDERS=
# DISCORD_WEBHOOK_MONITORING=
